{
  "sourceLanguage" : "en",
  "strings" : {
    "The update was installed, but automatic restart could not be started: %@. Quit TRClick and reopen it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update was installed, but automatic restart could not be started: %@. Quit TRClick and reopen it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已安装，但无法启动自动重启：%@。请完全退出 TRClick 后重新打开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización se instaló, pero no se pudo iniciar el reinicio automático: %@. Cierra TRClick por completo y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour est installée, mais le redémarrage automatique n’a pas pu être lancé : %@. Quittez TRClick, puis rouvrez l’application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新はインストールされましたが、自動再起動を開始できませんでした：%@。TRClick を完全に終了してから、再度開いてください。"
          }
        }
      }
    },
    "The update server did not return a valid HTTP response.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server did not return a valid HTTP response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务器未返回有效的 HTTP 响应。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de actualizaciones no devolvió una respuesta HTTP válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de mises à jour n’a pas renvoyé de réponse HTTP valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新サーバーから有効な HTTP 応答が返されませんでした。"
          }
        }
      }
    },
    "Update information is not available yet. Please open the release page to check for updates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update information is not available yet. Please open the release page to check for updates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新信息暂不可用。请打开发布页面查看最新版本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de actualización aún no está disponible. Abre la página de versiones para buscar actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de mise à jour ne sont pas encore disponibles. Ouvrez la page des versions pour vérifier les mises à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新情報はまだ利用できません。リリースページで最新バージョンを確認してください。"
          }
        }
      }
    },
    "The update server returned HTTP %ld. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server returned HTTP %ld. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务器返回 HTTP %ld。请稍后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de actualizaciones devolvió HTTP %ld. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de mises à jour a renvoyé HTTP %ld. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新サーバーから HTTP %ld が返されました。しばらくしてから再試行してください。"
          }
        }
      }
    },
    "The update information is invalid. Please open the release page to download manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update information is invalid. Please open the release page to download manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新信息格式无效。请打开发布页面手动下载。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de actualización no es válida. Abre la página de versiones para descargarla manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de mise à jour sont invalides. Ouvrez la page des versions pour télécharger manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新情報の形式が無効です。リリースページから手動でダウンロードしてください。"
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前未连接到互联网。请检查网络后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que no tienes conexión. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous semblez être hors ligne. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続されていません。接続を確認して再試行してください。"
          }
        }
      }
    },
    "The update check timed out. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update check timed out. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新超时。请稍后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera al buscar actualizaciones. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de mises à jour a expiré. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新の確認がタイムアウトしました。しばらくしてから再試行してください。"
          }
        }
      }
    },
    "Template Required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template Required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita una plantilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle requis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートが必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要模板"
          }
        }
      }
    },
    "Choose a valid %@ template in Settings > New File before creating this document.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid %@ template in Settings > New File before creating this document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una plantilla válida de %@ en Ajustes > Nuevo archivo antes de crear este documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle %@ valide dans Réglages > Nouveau fichier avant de créer ce document."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類を作成する前に、「設定」>「新規ファイル」で有効な %@ テンプレートを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置 > 新建文件”中选择有效的 %@ 模板，再创建此文档。"
          }
        }
      }
    },
    "Template Could Not Be Saved": {
      "extractionState": "manual",
      "localizations": {
