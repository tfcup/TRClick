    "Are you sure you want to delete \"%@\" (%@)? This action cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete \"%@\" (%@)? This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
