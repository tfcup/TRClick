    "Applies to app icons in the Open With menu: none / simple (monochrome) / original" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to app icons in the Open With menu: none / simple (monochrome) / original"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于「打开方式」菜单中应用项的图标：无图标 / 简单图标（单色）/ 原始图标"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los iconos de las apps del menú Abrir con: ninguno / simple (monocromo) / original"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux icônes des apps du menu Ouvrir avec : aucune / simple (monochrome) / originale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このアプリケーションで開く」のアイコン：なし／シンプル（単色）／オリジナル"
          }
        }
      }
    },
