    "TRClick is a right-click menu extension that allows you to add applications for opening folders and includes some common actions." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick is a right-click menu extension that allows you to add applications for opening folders and includes some common actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick es una extensión del menú contextual que te permite agregar aplicaciones para abrir carpetas e incluye algunas acciones frecuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick est une extension du menu clic droit qui vous permet d’ajouter des applications pour ouvrir des dossiers et inclut quelques actions courantes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick はフォルダを開くアプリを追加できる右クリックメニュー拡張で、いくつかの便利な操作も含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick 是一个右键菜单扩展，可以添加打开文件夹的应用，并提供一些常用操作。"
          }
        }
      }
    },
    "TRClick is installed from the Mac App Store. Please update it from the App Store." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick is installed from the Mac App Store. Please update it from the App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick se instaló desde la Mac App Store. Actualízalo desde la App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick a été installé depuis le Mac App Store. Veuillez le mettre à jour depuis l’App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick は Mac App Store からインストールされています。App Store からアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick 是从 Mac App Store 安装的。请从 App Store 更新。"
          }
        }
      }
    },
    "TRClick needs \"%@\" permission to rename a newly created file automatically. Enable it for the TRClick app in System Settings > %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick needs \"%@\" permission to rename a newly created file automatically. Enable it for the TRClick app in System Settings > %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick necesita el permiso «%@» para cambiar el nombre de un archivo recién creado automáticamente. Actívalo para la app TRClick en Ajustes del Sistema > %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick a besoin de l’autorisation « %@ » pour renommer automatiquement un fichier nouvellement créé. Activez-la pour l’app TRClick dans Réglages Système > %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick が新規作成したファイルの名前を自動で変更するには「%@」権限が必要です。システム設定 > %@ で TRClick アプリに許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick 需要「%@」权限，才能在新建文件后自动重命名。请在系统设置 > %@ 中为 TRClick 主程序开启该权限。"
          }
        }
      }
    },
    "TRClick needs permission to install the update into your Applications folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick needs permission to install the update into your Applications folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick necesita permiso para instalar la actualización en tu carpeta Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick a besoin d’une autorisation pour installer la mise à jour dans votre dossier Applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick がアップデートをアプリケーションフォルダにインストールするには権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRClick 需要权限以将更新安装到您的“应用程序”文件夹中。"
          }
        }
      }
    },
