    "TRClick is not running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick is not running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick no está en ejecución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick n’est pas lancé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick が実行されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick 未运行"
          }
        }
      }
    },
    "Restart TRClick to restore the menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart TRClick to restore the menu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia TRClick para restaurar el menú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez TRClick pour rétablir le menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick を再起動するとメニューが復元されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 TRClick 后菜单将恢复"
          }
        }
      }
    },
    "This action requires TRClick to be running. Please launch TRClick and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action requires TRClick to be running. Please launch TRClick and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción requiere que TRClick esté en ejecución. Inicia TRClick e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action nécessite que TRClick soit lancé. Veuillez lancer TRClick et réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作には TRClick の実行が必要です。TRClick を起動してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作需要 TRClick 正在运行。请启动 TRClick 后重试。"
          }
        }
      }
    },
    "TRClick did not respond": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick did not respond"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick no respondió"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick ne répond pas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick が応答しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TRClick 无响应"
          }
        }
      }
    },
    "The operation may not have been executed. Please check that TRClick is running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation may not have been executed. Please check that TRClick is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la operación no se haya ejecutado. Comprueba que TRClick esté en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération n’a peut-être pas été exécutée. Vérifiez que TRClick est lancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作が実行されていない可能性があります。TRClick が実行されているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作可能未执行。请确认 TRClick 正在运行。"
          }
        }
      }
    }
  },
  "version": "1.0"
